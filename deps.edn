;; Consumers depend on briko as a git dep; tools.deps reads this file to
;; resolve briko's own dependencies. babashka carries babashka.fs and
;; babashka.process built in, so bb.edn declares nothing.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "kaocha.runner"]}
  :dev {:extra-paths ["test" "dev"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}
  :eastwood {:extra-paths ["test"]
             :extra-deps {jonase/eastwood {:mvn/version "1.4.3"}
                          org.clojure/test.check {:mvn/version "1.1.3"}}
             :main-opts ["-m" "eastwood.lint"
                         "{:source-paths [\"src\"] :test-paths [\"test\"]}"]}
  :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.25.0"}}
           :main-opts ["-m" "noahtheduke.splint" "src" "test"]}
  :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
           :main-opts ["-m" "cljfmt.main"]}
  :watson {:extra-deps {io.github.clj-holmes/clj-watson
                        {:git/tag "v6.2.0" :git/sha "c0dcdf323efb349baa9ec964298f725baccda73b"}}
           :main-opts ["-m" "clj-watson.cli" "scan"]}}}
